generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomType{
PRIVATE
GROUP
}
enum MemberRole{
OWNER
ADMIN
MEMBER
}

model Room{
id           String  @id @default(uuid())
name         String?
type         RoomType
createdById  String
createdAt   DateTime     @default(now())
updatedAt   DateTime     @updatedAt

members      RoomMember[]
messages     Message[]

  @@map("rooms")
}
model RoomMember{
id            String   @id() @default(uuid())
roomId         String
userId          String
role             MemberRole
joinedAt DateTime   @default(now())

room   Room  @relation(fields:[roomId],references:[id],onDelete:Cascade)
@@unique([roomId, userId])
@@index([userId])
@@map("room_members")
}

model  Message{
id            String   @id() @default(uuid())
roomId         String
senderId         String
content   String
createdAt DateTime @default(now())

room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)

@@index([roomId, createdAt(sort: Desc)])
@@map("messages")
}

model OutBox{
id              String       @id @default(uuid())
topic           String
key              String        // partition key (roomId)
payload         Json
createdAt   DateTime @default(now())
publishedAt DateTime?        // null = not yet published
attempts    Int      @default(0)

@@index([publishedAt, createdAt])   // for the poller
@@map("outbox")
}
